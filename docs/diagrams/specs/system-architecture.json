      "dot": "emerald",
      "title": "Modular Monolith",
      "items": [
        "7 strictly decoupled modules communicating via MediatR and MassTransit events",
        "Zero cross-schema foreign keys in MSSQL; eventual consistency via Outbox"
      ]
    },
    {
      "dot": "cyan",
      "title": "Direct S3 Ingestion",
      "items": [
        "Heavy audio & image uploads stream directly from browser to RustFS S3",
        "Short-lived presigned URLs keep API server stateless and lightweight"
      ]
    },
    {
      "dot": "violet",
      "title": "Reliable Messaging",
      "items": [
        "MassTransit transactional outbox guarantees at-least-once message delivery",
        "S3 bucket notifications consumed with idempotency deduplication"
      ]
    }
