  "cards": [
    {
      "dot": "emerald",
      "title": "Zero API Bandwidth Overhead",
      "items": [
        "Audio streams bypass the .NET API entirely, streaming straight into S3",
        "Presigned URLs expire in 15 minutes to guarantee security"
      ]
    },
    {
      "dot": "cyan",
      "title": "Atomic Numbering Reservation",
      "items": [
        "Uses EF Core ExecuteUpdateAsync row-level locking on the parent Album",
        "Prevents duplicate or conflicting track numbers under concurrent requests"
      ]
    },
    {
      "dot": "violet",
      "title": "Idempotent Event Ingestion",
      "items": [
        "BucketNotificationConsumer records event IDs in ProcessedEvents table",
        "Prevents duplicate validation jobs from duplicate S3 webhook calls"
      ]
    }
  ]
