	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SoundWave.SharedKernel\SoundWave.SharedKernel.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
	</ItemGroup>

	<ItemGroup>
